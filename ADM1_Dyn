# ---------------------------------------------------------------------------
# Constantes, máscaras de componente e grupos (valem para qualquer grade)
# ---------------------------------------------------------------------------
IDs    = list(cmps.IDs)                       # ordem das colunas de scope.record
i_mass = np.asarray(cmps.i_mass, dtype=float) # kg componente / kg substância medida
i_COD  = np.asarray(cmps.i_COD, dtype=float)  # kg DQO / kg substância medida
