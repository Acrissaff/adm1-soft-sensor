def reamostrar(serie, metodo='linear'):
    '''Linear para séries contínuas; "ffill" para degraus (o DynamicInfluent é degrau).'''
    serie = np.asarray(serie, dtype=float)
    if metodo == 'ffill':
        i = np.searchsorted(tempo_nativo, grade, side='right') - 1
        return serie[np.clip(i, 0, len(serie) - 1)]
    return np.interp(grade, tempo_nativo, serie)

def reamostrar_matriz(matriz, metodo='linear'):
    matriz = np.asarray(matriz, dtype=float)
    return np.column_stack([reamostrar(matriz[:, j], metodo) for j in range(matriz.shape[1])])

estados_efl_grade = reamostrar_matriz(effluent_states)
estados_inf_grade = reamostrar_matriz(influent_states, 'ffill')
estados_gas_grade = reamostrar_matriz(gas_states)

reg = derivar(estados_efl_grade, estados_inf_grade, estados_gas_grade, reamostrar(gas_Q_m3d))
