ts_idx  = np.flatnonzero(~water & ~diss_gas)                  # sólidos totais
vss_idx = np.flatnonzero(part)                                # sólidos voláteis (= TSS)
cod_idx = np.flatnonzero((i_COD > 0) & ~diss_gas)             # DQO total
