#Estados em .csv, com tempo em dias, vazão em m3/d e concentrações em mg/L
def montar_tabela(tempo, inf_mgL, inf_Q, eff_mgL, eff_Q, gas_gm3, gas_Q, derivados):
    '''Monta a tabela exportável: estados das correntes + variáveis de pós-processamento.'''
    dados = {'t': np.asarray(tempo)}                          # [d]
    for prefixo, matriz, Q in (('inf', inf_mgL, inf_Q), ('eff', eff_mgL, eff_Q),
                               ('gas', gas_gm3, gas_Q)):
        matriz = np.asarray(matriz)
        for i, ID in enumerate(IDs):
            dados[f'{prefixo}_{ID}'] = matriz[:, i]           # mg/L (líquido) | g/m3 (gás)
        dados[f'{prefixo}_Q'] = np.asarray(Q)                 # m3/d
    for k, ID in enumerate(gas_ids):                          # composição molar do biogás
        dados[f'gas_x_{ID}'] = derivados['gas_frac_molar'][:, k]      # mol/mol, base úmida
        dados[f'gas_x_seca_{ID}'] = derivados['gas_frac_seca'][:, k]  # mol/mol, base seca
    dados.update({
        'pH': derivados['pH'],
        'alk_hco3': derivados['alk_hco3'],
        'alk_vfa': derivados['alk_vfa'],
        'alk_total': derivados['alk_total'],
        'alk_conservativa': derivados['alk_conservativa'],
        'acidez_volatil_total': derivados['acidez_volatil_total'],
        'ts_inf': derivados['ts_influente_mgL'],
        'vss_inf': derivados['vss_influente_mgL'],
        'ts_eff': derivados['ts_mgL'],
        'vss_eff': derivados['vss_mgL'],
        'cod_inf': derivados['cod_influente_mgL'],
        'cod_eff': derivados['cod_mgL'],
        'tan_inf': derivados['tan_influente_mgL'],
        'tan_eff': derivados['tan_efluente_mgL'],
        'fan_eff': derivados['fan_mgN_L'],
        })
    return pd.DataFrame(dados)

def exportar(tabela, path):
    tabela.to_csv(path, index=False)
    print(f'Exportado {path}: {tabela.shape[0]} instantes x {tabela.shape[1]} colunas')
    return tabela

df_series = exportar(montar_tabela(
