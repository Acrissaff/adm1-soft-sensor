# Ka segue ADM1._acid_base_pairs: Ka[0]=Kw, Ka[1]=NH4+/NH3, Ka[2]=CO2/HCO3-,
# Ka[3:7]=HAc/Ac-, HPr/Pr-, HBu/Bu-, HVa/Va- (dissociação parcial em cada pH)
EQ_TO_MG_CACO3 = 5e4                          # 1 equivalente = 50 g CaCO3
vfa_ids = ('S_ac', 'S_pro', 'S_bu', 'S_va')
idx = {ID: cmps.index(ID) for ID in ('S_cat', 'S_an', 'S_IN', 'S_IC') + vfa_ids}
vfa_idx = [idx[ID] for ID in vfa_ids]

# ---------------------------------------------------------------------------
# Pós-processamento: a mesma rotina serve a qualquer grade de estados
# ---------------------------------------------------------------------------
def derivar(estados_efluente, estados_influente, estados_gas, Q_gas):
    '''Deriva os observáveis a partir dos estados (kg/m3 no líquido, g/m3 no gás).

    Aplicada sobre uma grade reamostrada, recalcula o equilíbrio ácido-base em cada ponto
    em vez de interpolar pH/alcalinidade, que não são lineares no estado.
    '''
    states_mol_L = estados_efluente * unit_conversion

    # [H+] em equilíbrio de cada estado; mesma solução usada internamente pelo modelo
    h_ion = np.array([
        adm1.solve_pH(state, Ka, unit_conversion)
        for state in estados_efluente
    ])
    pH = -np.log10(h_ion)

    # Alcalinidade
    oh_ion = Ka[0] / h_ion
    nh3 = Ka[1] * states_mol_L[:, idx['S_IN']] / (Ka[1] + h_ion)
    hco3 = Ka[2] * states_mol_L[:, idx['S_IC']] / (Ka[2] + h_ion)
    vfa_diss = np.sum(
        states_mol_L[:, vfa_idx] * (Ka[3:7] / (Ka[3:7] + h_ion[:, None])),
        axis=1,
    )

    alk_hco3 = hco3 * EQ_TO_MG_CACO3                 # HCO3- estimado do carbono inorgânico
    alk_vfa = vfa_diss * EQ_TO_MG_CACO3              # acetato, propionato, butirato e valerato
    alk_total = alk_hco3 + alk_vfa

    # S_cat e S_an são íons fortes inertes (nenhum processo os consome): fecham o balanço de cargas
    alk_ions_fortes = (states_mol_L[:, idx['S_cat']] - states_mol_L[:, idx['S_an']]) * EQ_TO_MG_CACO3
    alk_total_conservativa = alk_ions_fortes + states_mol_L[:, idx['S_IN']] * EQ_TO_MG_CACO3
    # Resíduo deve ser ~0: (S_cat - S_an) + S_IN == alcalinidade de bicarbonato + AGVs + NH3 + OH- - H+
    residuo_balanco = (alk_total_conservativa - alk_total
                       - nh3 * EQ_TO_MG_CACO3 - oh_ion * EQ_TO_MG_CACO3 + h_ion * EQ_TO_MG_CACO3)

    # Acidez volátil total (AGVs totais): todas as espécies, em equivalentes de CaCO3
    acidez_volatil_total = states_mol_L[:, vfa_idx].sum(axis=1) * EQ_TO_MG_CACO3

    # Sólidos como massa de componente (convertidos da substância medida por i_mass)
    ts_mgL = (estados_efluente[:, ts_idx] @ i_mass[ts_idx]) * 1e3
    vss_mgL = (estados_efluente[:, vss_idx] @ i_mass[vss_idx]) * 1e3
    ts_influente_mgL = (estados_influente[:, ts_idx] @ i_mass[ts_idx]) * 1e3
    vss_influente_mgL = (estados_influente[:, vss_idx] @ i_mass[vss_idx]) * 1e3

    # DQO total: i_COD = 1 no ADM1, então o estado em mg/L já é mg DQO/L
    cod_mgL = (estados_efluente[:, cod_idx] @ i_COD[cod_idx]) * 1e3
    cod_influente_mgL = (estados_influente[:, cod_idx] @ i_COD[cod_idx]) * 1e3

    # TAN (mg N/L) e FAN (mg N/L, depende do pH do reator)
    tan_influente_mgL = estados_influente[:, idx['S_IN']] * 1e3
    tan_efluente_mgL = estados_efluente[:, idx['S_IN']] * 1e3
    fan_mgN_L = nh3 * N_mw * 1e3

    # Composição molar do biogás, base úmida e base seca
    gas_mol_m3 = estados_gas[:, gas_idx] / MW[gas_idx]
    gas_mol_total = gas_mol_m3.sum(axis=1, keepdims=True)
    gas_frac_molar = np.divide(gas_mol_m3, gas_mol_total,
                               out=np.zeros_like(gas_mol_m3), where=gas_mol_total > 0)
    gas_x_h2o = gas_frac_molar[:, [gas_h2o]]
    gas_frac_seca = np.divide(gas_frac_molar, 1 - gas_x_h2o,
                              out=np.zeros_like(gas_frac_molar), where=(1 - gas_x_h2o) > 0)

    return dict(
        pH=pH, alk_hco3=alk_hco3, alk_vfa=alk_vfa, alk_total=alk_total,
        alk_conservativa=alk_total_conservativa, residuo_balanco=residuo_balanco,
        acidez_volatil_total=acidez_volatil_total,
        ts_mgL=ts_mgL, vss_mgL=vss_mgL,
        ts_influente_mgL=ts_influente_mgL, vss_influente_mgL=vss_influente_mgL,
        cod_mgL=cod_mgL, cod_influente_mgL=cod_influente_mgL,
        tan_influente_mgL=tan_influente_mgL, tan_efluente_mgL=tan_efluente_mgL,
        fan_mgN_L=fan_mgN_L,
        gas_frac_molar=gas_frac_molar, gas_frac_seca=gas_frac_seca,
    )

